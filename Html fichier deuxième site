<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Precious Cyber Security</title>
  <!-- Google Fonts & FontAwesome Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }

    body {
      background: linear-gradient(180deg, #18092B 0%, #3D1047 35%, #7D2447 65%, #E65A28 100%);
      min-height: 100vh;
      color: #FFFFFF;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* En-tête / Header */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(10px);
    }

    .header-left, .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .icon-btn {
      background: none;
      border: none;
      color: #FFF;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .site-title-main {
      font-size: 1.1rem;
      font-weight: 700;
    }

    /* Zone de profil */
    .profile-section {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px;
    }

    .profile-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #FFBA08;
    }

    .profile-text h2 {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .profile-text p {
      font-size: 0.9rem;
      color: #E0E0E0;
    }

    .add-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.1);
      color: #FFF;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.3s;
    }

    .add-btn:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    /* Filtres / Badges */
    .filter-section {
      padding: 0 20px;
      margin-bottom: 40px;
    }

    .tag-btn {
      background: #FFBA08;
      color: #1a1a1a;
      border: none;
      padding: 8px 18px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
    }

    /* Contenu principal / Message vide */
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
    }

    .empty-message {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1rem;
      line-height: 1.5;
      max-width: 320px;
    }

    /* Footer */
    footer {
      padding: 20px;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .footer-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
    }

    .footer-text {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.8);
    }

    /* ====================================
       WIDGET DU CHAT IA
    ==================================== */
    .ai-chat-toggle {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #FFBA08;
      color: #1A0B2E;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      cursor: pointer;
      border: none;
      z-index: 1000;
      transition: transform 0.2s;
    }

    .ai-chat-toggle:hover {
      transform: scale(1.08);
    }

    .ai-chat-box {
      position: fixed;
      bottom: 90px;
      right: 24px;
      width: 340px;
      height: 440px;
      background: #1A0B2E;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      display: none;
      flex-direction: column;
      overflow: hidden;
      z-index: 1000;
    }

    .ai-chat-header {
      background: rgba(255, 255, 255, 0.08);
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ai-chat-header h3 {
      font-size: 0.95rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ai-chat-messages {
      flex: 1;
      padding: 12px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .msg {
      max-width: 80%;
      padding: 8px 12px;
      border-radius: 12px;
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .msg.bot {
      background: rgba(255, 255, 255, 0.1);
      align-self: flex-start;
      border-bottom-left-radius: 2px;
    }

    .msg.user {
      background: #FFBA08;
      color: #1A0B2E;
      align-self: flex-end;
      border-bottom-right-radius: 2px;
      font-weight: 500;
    }

    .ai-chat-input {
      display: flex;
      padding: 10px;
      background: rgba(0, 0, 0, 0.2);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ai-chat-input input {
      flex: 1;
      background: rgba(255, 255, 255, 0.1);
      border: none;
      padding: 8px 12px;
      border-radius: 20px;
      color: #FFF;
      outline: none;
      font-size: 0.85rem;
    }

    .ai-chat-input button {
      background: none;
      border: none;
      color: #FFBA08;
      padding: 0 10px;
      cursor: pointer;
      font-size: 1rem;
    }
  </style>
</head>
<body>

  <!-- Navigation Superieure -->
  <header>
    <div class="header-left">
      <button class="icon-btn"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="site-title-main">Precious Cyber Security</div>
    <div class="header-right">
      <button class="icon-btn"><i class="fa-regular fa-comment-dots"></i></button>
      <button class="icon-btn"><i class="fa-solid fa-share-nodes"></i></button>
    </div>
  </header>

  <!-- Section Profil -->
  <section class="profile-section">
    <div class="profile-info">
      <!-- Remplace 'avatar.jpg' par ton image -->
      <img src="https://via.placeholder.com/150" alt="Precious" class="avatar">
      <div class="profile-text">
        <h2>Precious</h2>
        <p>Cyber Security</p>
      </div>
    </div>
    <button class="add-btn"><i class="fa-solid fa-plus"></i></button>
  </section>

  <!-- Filtres -->
  <div class="filter-section">
    <button class="tag-btn">Tous</button>
  </div>

  <!-- Zone Principale -->
  <main>
    <p class="empty-message">
      Aucun cours pour l'instant.<br>
      Touche le + en haut à droite pour rédiger le premier.
    </p>
  </main>

  <!-- Pied de page -->
  <footer>
    <img src="https://via.placeholder.com/150" alt="Precious" class="footer-avatar">
    <span class="footer-text">Site créé et tenu par Precious</span>
  </footer>

  <!-- Widget de Chat IA -->
  <button class="ai-chat-toggle" onclick="toggleChat()">
    <i class="fa-solid fa-robot"></i>
  </button>

  <div class="ai-chat-box" id="aiChatBox">
    <div class="ai-chat-header">
      <h3><i class="fa-solid fa-bot"></i> Assistant Cyber IA</h3>
      <button class="icon-btn" onclick="toggleChat()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="ai-chat-messages" id="chatMessages">
      <div class="msg bot">
        Bonjour ! Je suis l'assistant virtuel de Precious Cyber Security. Comment puis-je t'aider aujourd'hui ?
      </div>
    </div>
    <div class="ai-chat-input">
      <input type="text" id="userInput" placeholder="Pose une question..." onkeypress="handleKeyPress(event)">
      <button onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
    </div>
  </div>

  <script>
    function toggleChat() {
      const chatBox = document.getElementById('aiChatBox');
      chatBox.style.display = (chatBox.style.display === 'flex') ? 'none' : 'flex';
    }

    function handleKeyPress(e) {
      if (e.key === 'Enter') {
        sendMessage();
      }
    }

    function sendMessage() {
      const input = document.getElementById('userInput');
      const text = input.value.trim();
      if (!text) return;

      const messagesContainer = document.getElementById('chatMessages');

      // Ajout du message utilisateur
      const userMsg = document.createElement('div');
      userMsg.className = 'msg user';
      userMsg.textContent = text;
      messagesContainer.appendChild(userMsg);

      input.value = '';
      messagesContainer.scrollTop = messagesContainer.scrollHeight;

      // Simulation de la réponse IA
      setTimeout(() => {
        const botMsg = document.createElement('div');
        botMsg.className = 'msg bot';
        botMsg.textContent = "Merci pour ta question ! Les cours de cybersécurité arrivent très bientôt. En attendant, n'hésite pas à repasser !";
        messagesContainer.appendChild(botMsg);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }, 1000);
    }
  </script>

</body>
</html>

